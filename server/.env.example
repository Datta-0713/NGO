NODE_ENV=development
PORT=5000

# MongoDB
MONGO_URI=mongodb://localhost:27017/nexy-foundation

# JWT
JWT_ACCESS_SECRET=your_access_secret_here_change_in_prod
JWT_REFRESH_SECRET=your_refresh_secret_here_change_in_prod
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Cloudinary
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Client
CLIENT_URL=http://localhost:5173
MOBILE_URL=exp://localhost:8081

# Credits
DEFAULT_CREDIT_AMOUNT=10
WELCOME_BONUS_CREDITS=5
