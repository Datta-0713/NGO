{
  "expo": {
    "name": "NEXY Foundation",
    "slug": "nexy-foundation",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ],
      "package": "com.dipanjan13.nexyfoundation"
    },
    "web": {},
    "plugins": [
      "expo-font",
      "expo-image-picker",
      "expo-location",
      "expo-secure-store"
    ],
    "extra": {
      "eas": {
        "projectId": "8ce21783-ea59-4582-95f4-d9bf45826eb6"
      }
    }
  }
}
